# Build output. Everything here is regenerated by ./build.sh in about 0.2s.
bin/

# Regenerated by every successful build via `clang -MJ`. Machine-specific: it
# embeds absolute paths and this machine's musl sysroot, so committing it would
# hand the next checkout the wrong include paths.
compile_commands.json

# clangd's index, written by the editor rather than the build.
.cache/

# Editor and OS cruft
*.swp
*~
.DS_Store
.idea/

# NOT ignored, on purpose: .vscode/ holds the lldb-dap launch config and the
# build tasks, which are project setup rather than personal preference. The
# localdrop .hgignore excludes .vscode/; this project deliberately does not.
